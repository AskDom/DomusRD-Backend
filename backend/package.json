{
  "name": "domify-backend",
  "version": "1.0.0",
  "description": "API backend para Domify - Portal Inmobiliario",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "npx prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "dotenv -e .env.test -- jest --runInBand",
    "test:watch": "dotenv -e .env.test -- jest --runInBand --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.68.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "socket.io-parser": "^4.2.7",
    "ip-address": "^10.4.0",
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  }
}
