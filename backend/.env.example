# Base de datos PostgreSQL
# Si usas "docker compose up -d" desde la raíz del repo, estas son las
# credenciales que ya vienen configuradas ahí.
DATABASE_URL="postgresql://domify:domify_dev_password@localhost:5432/domify?schema=public"

# JWT — mínimo 32 caracteres, valor aleatorio largo
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=5000
NODE_ENV=development

# CORS - URL del frontend (separadas por coma si hay varias)
FRONTEND_URL="http://localhost:3000"

# Cloudinary — Subida de imágenes
# Crea tu cuenta gratis en https://cloudinary.com y copia estos valores
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Resend (envío de correos - recuperación de contraseña)
# Sin esto, el link de reseteo solo se imprime en la consola del servidor.
RESEND_API_KEY=""
MAIL_FROM="Domify <onboarding@resend.dev>"

# Sentry (tracking de errores en producción). Sin esto, no se manda nada.
SENTRY_DSN=""
