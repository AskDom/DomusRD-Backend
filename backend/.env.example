# Base de datos PostgreSQL
# Si usas "docker compose up -d" desde la raíz del repo, estas son las
# credenciales que ya vienen configuradas ahí.
DATABASE_URL="postgresql://domify:domify_dev_password@localhost:5432/domify?schema=public"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=5000
NODE_ENV=development

# CORS - URL del frontend
FRONTEND_URL="http://localhost:3000"

# Resend (envío de correos - recuperación de contraseña)
# Sin esto, el link de reseteo solo se imprime en la consola del servidor.
RESEND_API_KEY=""
MAIL_FROM="Domify <onboarding@resend.dev>"

# Sentry (tracking de errores en producción). Sin esto, no se manda nada.
SENTRY_DSN=""

# Logging (pino). Por defecto: "debug" en development, "info" en production.
# LOG_LEVEL="debug"
