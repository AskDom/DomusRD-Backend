# Base de datos PostgreSQL
# Si usas "docker compose up -d" desde la raíz del repo, estas son las
# credenciales que ya vienen configuradas ahí.
DATABASE_URL="postgresql://domusrd:domusrd_dev_password@localhost:5432/domusrd?schema=public"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=5000
NODE_ENV=development

# CORS - URL del frontend
FRONTEND_URL="http://localhost:3000"

# Resend (envío de correos - recuperación de contraseña)
# Sin esto, el link de reseteo solo se imprime en la consola del servidor.
RESEND_API_KEY=""
MAIL_FROM="DomusRD <onboarding@resend.dev>"
