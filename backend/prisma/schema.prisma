// Schema de Domify — adaptado del esquema original
// para reflejar los modelos usados en el frontend (localStorage -> Postgres)

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm habilita los índices GIN de abajo — sin esto, ILIKE '%texto%'
  // en title/city/sector siempre termina en Seq Scan sin importar cuántos
  // índices btree tenga la tabla (ver prueba de carga del 2026-08-10).
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ── ENUMS ────────────────────────────────────────────────────────────────

enum Role {
  CLIENTE
  VENDEDOR
  AGENTE
  ADMIN
}

enum PropertyStatus {
  VENTA
  RENTA
  VENDIDO
  RENTADO
}

enum PropertyType {
  APARTAMENTO
  CASA
  VILLA
}

enum Currency {
  USD
  DOP
}

enum VisitStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

// ── MODELS ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENTE)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Se incrementa en logout, cambio de contraseña y cambio de rol por un
  // admin — el JWT lleva este número al momento de emitirse (ver jwt.js) y
  // "protect" lo compara contra el valor actual en cada request. Sin esto,
  // un JWT robado seguía siendo válido hasta su expiración natural (hasta 7
  // días) aunque el dueño cerrara sesión o un admin le cambiara el rol.
  tokenVersion Int @default(0)

  // Verificación de agente/vendedor otorgada por un admin — el mismo criterio
  // de confianza que ya existía para propiedades (Property.verified), pero a
  // nivel de cuenta: un perfil verificado sale con su sello en el detalle de
  // propiedades y en su perfil público.
  verified   Boolean    @default(false)
  verifiedAt DateTime?

  properties      Property[]
  favorites       Favorite[]
  sentMessages    Message[]  @relation("MessagesSent")
  receivedMessages Message[] @relation("MessagesReceived")
  reviews         Review[]
  savedSearches   SavedSearch[]
  notifications   Notification[]
  pushTokens      PushToken[]
  uploadedImages  UploadedImage[]
  visitsRequested Visit[]    @relation("VisitsRequested")

  @@map("users")
}

// Registra quién subió cada imagen a Cloudinary vía POST /api/upload — es
// la fuente de verdad para poder borrarla (DELETE /api/upload). Antes de
// esto, "puedo borrar esta imagen" se decidía viendo si la URL aparecía en
// el array `images` de una propiedad propia, pero ese array lo puede editar
// el propio usuario (PUT /api/properties/:id) con CUALQUIER URL de
// Cloudinary — copiando la foto pública de otro usuario ahí, cualquiera
// podía borrarle la imagen real. Con esta tabla, el permiso depende de
// quién la subió originalmente, no de qué propiedad la referencia hoy.
model UploadedImage {
  id        String   @id @default(uuid())
  url       String   @unique
  publicId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("uploaded_images")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  platform  String?

  createdAt DateTime @default(now())

  @@map("push_tokens")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  message    String
  propertyId String?
  read       Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@map("notifications")
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  filters   Json

  createdAt DateTime @default(now())

  @@map("saved_searches")
}

model Property {
  id          String         @id @default(uuid())
  title       String
  description String
  price       Float
  currency    Currency       @default(USD)
  city        String
  sector      String?        // Barrio/sector dentro de la ciudad (ej. "Piantini", "Sabana Larga") — opcional, para búsquedas más finas que solo la ciudad.
  type        PropertyType   @default(APARTAMENTO)
  status      PropertyStatus @default(VENTA)

  rooms       Int            @default(1)
  baths       Int            @default(1)
  parking     Int            @default(0)

  lat         Float
  lng         Float

  images      String[]       // URLs de las fotos (portada = images[0])
  verified    Boolean        @default(false)
  verifiedAt  DateTime?      // Cuándo un admin dio el visto bueno — para el panel y auditoría.

  // Tour virtual / video de la propiedad (opcionales). videoUrl suele ser un
  // enlace de YouTube/Vimeo; virtualTourUrl un embebible de Matterport, 3DVista
  // u otra plataforma de recorridos 360°. No se suben a Cloudinary: son URLs
  // que el vendedor pega y el frontend renderiza en un iframe o enlaza.
  videoUrl       String?
  virtualTourUrl String?

  publishedById String
  publishedBy   User         @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  favorites   Favorite[]
  messages    Message[]
  reviews     Review[]
  visits      Visit[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // btree — filtros exactos y el ORDER BY del listado (createdAt es el que
  // más pega: hasta las cargas del mapa, sin ningún filtro, lo usan).
  // Compuesto con id: es el mismo par (createdAt, id) que usa el WHERE del
  // keyset de ?cursor= en getProperties — cubre tanto el ORDER BY simple
  // como el desempate de filas con el mismo createdAt.
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([createdAt, id])
  // Para ?bbox=... (GET /api/properties) — filtrar por el viewport del
  // mapa en vez de traer todo y recortar en el cliente.
  @@index([lat, lng])
  // GIN + pg_trgm — para que `contains ... insensitive` (ILIKE '%texto%')
  // en /api/properties?search= dejen de escanear la tabla completa.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_title_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_city_trgm_idx")
  @@index([sector(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_sector_trgm_idx")

  @@map("properties")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}

model Message {
  id         String   @id @default(uuid())

  fromId     String
  from       User     @relation("MessagesSent", fields: [fromId], references: [id], onDelete: Cascade)

  toId       String
  to         User     @relation("MessagesReceived", fields: [toId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  text       String
  read       Boolean  @default(false)
  replyToId  String?

  // Si el mensaje representa una solicitud de visita (o su confirmación/
  // cancelación), apunta a la visita para poder pintar el estado y las
  // acciones (confirmar/cancelar) directo en el hilo de mensajería.
  visitId  String?
  visit    Visit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([fromId])
  @@index([toId])
  @@index([visitId])
  @@map("messages")
}


model Review {
  id         String   @id @default(uuid())
  rating     Int      // 1-5
  comment    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, propertyId]) // un usuario solo puede reseñar una vez por propiedad
  @@map("reviews")
}

// Solicitud de visita a una propiedad — el interesado agenda una fecha/hora y
// el dueño la confirma, cancela o marca como completada. Es un mensaje
// estructurado (con estado) que acompaña al hilo de mensajería, no un
// reemplazo: el interesado sigue pudiendo escribirle al vendedor aparte.
model Visit {
  id          String      @id @default(uuid())

  // Quién agenda la visita (el interesado, nunca el dueño de la propiedad).
  userId      String
  user        User        @relation("VisitsRequested", fields: [userId], references: [id], onDelete: Cascade)

  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  scheduledAt DateTime    // Cuándo pide visitar
  message     String?     // Nota opcional del interesado

  status      VisitStatus @default(PENDIENTE)
  createdAt   DateTime    @default(now())

  // Mensajes de DM que representan esta solicitud (el pedido inicial del
  // interesado y la confirmación/cancelación del dueño, con visitId).
  messages    Message[]

  // Las dos caras del dashboard: "mis solicitudes" (userId) y "visitas a mis
  // propiedades" (propertyId → publishedById).
  @@index([userId])
  @@index([propertyId])
  @@map("visits")
}
