// Schema de Domify — adaptado del esquema original
// para reflejar los modelos usados en el frontend (localStorage -> Postgres)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── ENUMS ────────────────────────────────────────────────────────────────

enum Role {
  CLIENTE
  VENDEDOR
  AGENTE
  ADMIN
}

enum PropertyStatus {
  VENTA
  RENTA
  VENDIDO
  RENTADO
}

enum PropertyType {
  APARTAMENTO
  CASA
  VILLA
}

enum Currency {
  USD
  DOP
}

// ── MODELS ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENTE)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  
  properties      Property[]
  favorites       Favorite[]
  sentMessages    Message[]  @relation("MessagesSent")
  receivedMessages Message[] @relation("MessagesReceived")
  reviews         Review[]
  savedSearches   SavedSearch[]
  notifications   Notification[]
  pushTokens      PushToken[]

  @@map("users")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  platform  String?

  createdAt DateTime @default(now())

  @@map("push_tokens")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  message    String
  propertyId String?
  read       Boolean  @default(false)

  createdAt  DateTime @default(now())

  // Mismo caso que Message: todo getNotifications/getUnreadCount filtra
  // por userId — sin índice, table scan completo en cada carga.
  @@index([userId])
  @@map("notifications")
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  filters   Json

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_searches")
}

model Property {
  id          String         @id @default(uuid())
  title       String
  description String
  price       Float
  currency    Currency       @default(USD)
  city        String
  sector      String?        // Barrio/sector dentro de la ciudad (ej. "Piantini", "Sabana Larga") — opcional, para búsquedas más finas que solo la ciudad.
  type        PropertyType   @default(APARTAMENTO)
  status      PropertyStatus @default(VENTA)

  rooms       Int            @default(1)
  baths       Int            @default(1)
  parking     Int            @default(0)

  lat         Float
  lng         Float

  images      String[]       // URLs de las fotos (portada = images[0])
  verified    Boolean        @default(false)

  publishedById String
  publishedBy   User         @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  favorites   Favorite[]
  messages    Message[]
  reviews     Review[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // type/status son igualdad exacta y price es rango (gte/lte) en
  // buildPropertyWhere() — un índice B-tree ayuda directo a los tres.
  // createdAt cubre el ORDER BY que usa cualquier listado. city/sector NO
  // se indexan acá: se filtran con `contains` (ILIKE '%texto%'), que un
  // índice B-tree normal no acelera — necesitarían un índice GIN con
  // pg_trgm, que es un cambio más grande (preview feature de Prisma +
  // extensión de Postgres) y queda fuera de este PR a propósito.
  @@index([type])
  @@index([status])
  @@index([price])
  @@index([createdAt])
  @@map("properties")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}

model Message {
  id         String   @id @default(uuid())

  fromId     String
  from       User     @relation("MessagesSent", fields: [fromId], references: [id], onDelete: Cascade)

  toId       String
  to         User     @relation("MessagesReceived", fields: [toId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  text       String
  read       Boolean  @default(false)
  replyToId  String?

  createdAt  DateTime @default(now())

  // El inbox filtra por `OR: [{ fromId: userId }, { toId: userId }]` — sin
  // índice en estos dos campos, cada carga del inbox es un table scan
  // completo de messages.
  @@index([fromId])
  @@index([toId])
  @@index([propertyId])
  @@map("messages")
}


model Review {
  id         String   @id @default(uuid())
  rating     Int      // 1-5
  comment    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, propertyId]) // un usuario solo puede reseñar una vez por propiedad
  @@map("reviews")
}
