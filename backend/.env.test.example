# Base de datos de test (separada de la de desarrollo).
# "docker compose up -d" ya crea domify_test automáticamente con estas credenciales.
DATABASE_URL="postgresql://domify:domify_dev_password@localhost:5432/domify_test?schema=public"

JWT_SECRET="test-secret-solo-para-pruebas-no-usar-en-produccion"
JWT_EXPIRES_IN="7d"

PORT=5001
NODE_ENV=test

FRONTEND_URL="http://localhost:3000"

# Los tests de integración hacen varios register/login seguidos contra /api/auth;
# sin esto chocarían con el rate limit real de producción (10 cada 15 min).
AUTH_RATE_LIMIT_MAX=1000

# Vacía a propósito: PrismaClient carga el .env real del proyecto al
# instanciarse, y sin esto se cuela la RESEND_API_KEY real en los tests.
RESEND_API_KEY=""

# Misma razón que arriba: nunca queremos que un test dispare un evento real a Sentry.
SENTRY_DSN=""
