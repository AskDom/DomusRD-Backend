# Base de datos de test (separada de la de desarrollo, se recrea con cada corrida)
DATABASE_URL="postgresql://usuario:password@localhost:5432/domusrd_test?schema=public"

JWT_SECRET="test-secret-solo-para-pruebas-no-usar-en-produccion"
JWT_EXPIRES_IN="7d"

PORT=5001
NODE_ENV=test

FRONTEND_URL="http://localhost:3000"

# Los tests de integración hacen varios register/login seguidos contra /api/auth;
# sin esto chocarían con el rate limit real de producción (10 cada 15 min).
AUTH_RATE_LIMIT_MAX=1000
